<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kio_overtime_configuration_tree" model="ir.ui.view">
        <field name="name">kio.overtime.configuration.tree</field>
        <field name="model">kio.overtime.configuration</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="department_id"/>
                <field name="employee_id"/>
                <field name="total_employees"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'"/>
                <field name="company_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_kio_overtime_configuration_form" model="ir.ui.view">
        <field name="name">kio.overtime.configuration.form</field>
        <field name="model">kio.overtime.configuration</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state != 'confirmed'"/>
                    <button name="action_populate_lines" type="object" string="Populate Employees" class="btn-secondary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Reference"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" invisible="1"/>
                            <field name="employee_scope" readonly="state == 'confirmed'"/>
                            <field name="department_id" readonly="state == 'confirmed'"
                                   invisible="employee_scope != 'department'"
                                   required="employee_scope == 'department'"
                                   options="{'no_create': True}"/>
                            <field name="employee_id" invisible="1"/>
                            <field name="employee_ids" readonly="state == 'confirmed'" widget="many2many_tags"
                                   invisible="employee_scope != 'individual'"
                                   required="employee_scope == 'individual'"
                                   options="{'no_create': True}"
                                   domain="[('company_id', '=', company_id), ('active', '=', True)]"
                                   placeholder="Select employees..."/>
                            <field name="calculation_type" readonly="state == 'confirmed'"/>
                        </group>
                        <group>
                            <field name="total_employees" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Employee Overtime Rates" name="employee_overtime_rates">
                            <field name="line_ids" readonly="state == 'confirmed'">
                                <tree editable="bottom" decoration-danger="not has_applicable_contract">
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="has_applicable_contract" column_invisible="1"/>
                                    <field name="employee_id"/>
                                    <field name="department_id" readonly="1"/>
                                    <field name="basic_salary" readonly="1"/>
                                    <field name="per_hour_salary" readonly="1"/>
                                    <field name="per_hour_rate" column_invisible="parent.calculation_type == 'percentage'"/>
                                    <field name="per_day_rate" column_invisible="parent.calculation_type == 'percentage'"/>
                                    <field name="overtime_percentage" column_invisible="parent.calculation_type != 'percentage'"/>
                                    <field name="overtime_amount" readonly="1" column_invisible="parent.calculation_type != 'percentage'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_kio_overtime_configuration" model="ir.actions.act_window">
        <field name="name">Overtime Configuration</field>
        <field name="res_model">kio.overtime.configuration</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_kio_overtime_configuration"
              name="Overtime Configuration"
              parent="menu_kio_payroll_configuration"
              action="action_kio_overtime_configuration"
              groups="kio_payroll_overview_extension.group_kio_payroll_manager"
              sequence="10"/>
</odoo>
