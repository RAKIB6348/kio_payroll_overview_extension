<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_view_form_kio_allowances" model="ir.ui.view">
        <field name="name">hr.contract.form.kio.allowances</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='information']//group[@name='salary']//div[@name='wage']" position="after">
                <separator string="Allowances" colspan="2"/>
                <field name="kio_house_rent_allowance_percent" string="House Rent Allowance (%)"/>

                <field name="kio_medical_allowance" string="Medical Allowance" widget="monetary" options="{'currency_field': 'currency_id'}"/>

                <field name="kio_conveyance_allowance" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="kio_food_allowance" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="kio_mobile_allowance" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="kio_transport_allowance" widget="monetary" options="{'currency_field': 'currency_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
