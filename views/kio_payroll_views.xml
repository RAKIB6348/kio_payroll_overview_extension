<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kio_payroll_salary_config_tree" model="ir.ui.view">
        <field name="name">kio.payroll.salary.config.tree</field>
        <field name="model">kio.payroll.salary.config</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="company_id" column_invisible="1"/>
                <field name="employee_id"/>
                <field name="basic_salary"/>
                <field name="allowance"/>
                <field name="working_days"/>
                <field name="active"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_kio_payroll_salary_config_form" model="ir.ui.view">
        <field name="name">kio.payroll.salary.config.form</field>
        <field name="model">kio.payroll.salary.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="basic_salary"/>
                            <field name="allowance"/>
                        </group>
                        <group>
                            <field name="working_days"/>
                            <field name="company_id" invisible="1"/>
                            <field name="active"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kio_payroll_salary_config" model="ir.actions.act_window">
        <field name="name">Employee Salary Configuration</field>
        <field name="res_model">kio.payroll.salary.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_kio_payroll_batch_tree" model="ir.ui.view">
        <field name="name">kio.payroll.batch.tree</field>
        <field name="model">kio.payroll.batch</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="payment_date"/>
                <field name="employee_count"/>
                <field name="total_net"/>
                <field name="state"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_kio_payroll_batch_form" model="ir.ui.view">
        <field name="name">kio.payroll.batch.form</field>
        <field name="model">kio.payroll.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,cancel"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="payroll_type"/>
                            <field name="payment_date"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payslips">
                            <field name="payslip_ids" readonly="1">
                                <tree>
                                    <field name="number"/>
                                    <field name="employee_id"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="basic_salary"/>
                                    <field name="allowance"/>
                                    <field name="overtime"/>
                                    <field name="bonus"/>
                                    <field name="deduction"/>
                                    <field name="net_pay"/>
                                    <field name="paid"/>
                                    <field name="state"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_kio_payroll_batch" model="ir.actions.act_window">
        <field name="name">Payroll Batches</field>
        <field name="res_model">kio.payroll.batch</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_kio_payroll_payslip_tree" model="ir.ui.view">
        <field name="name">kio.payroll.payslip.tree</field>
        <field name="model">kio.payroll.payslip</field>
        <field name="arch" type="xml">
            <tree>
                <field name="number"/>
                <field name="employee_id"/>
                <field name="batch_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="net_pay"/>
                <field name="paid"/>
                <field name="state"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_kio_payroll_payslip_form" model="ir.ui.view">
        <field name="name">kio.payroll.payslip.form</field>
        <field name="model">kio.payroll.payslip</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,cancel"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="batch_id"/>
                            <field name="number"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="paid"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Salary Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Totals">
                            <group>
                                <field name="basic_salary"/>
                                <field name="allowance"/>
                                <field name="overtime"/>
                                <field name="bonus"/>
                                <field name="deduction"/>
                                <field name="gross_salary"/>
                                <field name="net_pay"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_kio_payroll_payslip" model="ir.actions.act_window">
        <field name="name">Employee Payslips</field>
        <field name="res_model">kio.payroll.payslip</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_kio_payroll_operations"
              name="Payroll Operations"
              parent="menu_payroll_root"
              groups="kio_payroll_overview_extension.group_kio_payroll_manager"
              sequence="20"/>
    <menuitem id="menu_kio_payroll_batches"
              name="Payroll Batches"
              parent="menu_kio_payroll_operations"
              action="action_kio_payroll_batch"
              groups="kio_payroll_overview_extension.group_kio_payroll_manager"
              sequence="10"/>
    <menuitem id="menu_kio_payroll_payslips"
              name="Employee Payslips"
              parent="menu_kio_payroll_operations"
              action="action_kio_payroll_payslip"
              groups="kio_payroll_overview_extension.group_kio_payroll_manager"
              sequence="20"/>
    <menuitem id="menu_kio_payroll_salary_config"
              name="Salary Configuration"
              parent="menu_kio_payroll_configuration"
              action="action_kio_payroll_salary_config"
              groups="kio_payroll_overview_extension.group_kio_payroll_manager"
              sequence="20"/>
</odoo>
